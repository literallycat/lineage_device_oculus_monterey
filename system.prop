# Audio
aaudio.hw_burst_min_usec=2000
aaudio.mmap_exclusive_policy=1
aaudio.mmap_policy=1
af.fast_track_multiplier=1
audio.a2dp.codec.latency=300/300/300/300
audio.deep_buffer.media=true
audio.offload.disable=true

# Bluetooth
ro.bluetooth.emb_wp_mode=true
ro.bluetooth.hfp.ver=1.6
ro.bluetooth.profiles=hid,a2dp

# Display
debug.egl.hw=1
debug.egl.swapPermissive=1
debug.sf.auto_refresh_fast_path=1
debug.sf.hw=1
debug.sf.shared_buffer_restrict=1
debug.sf.show_pointer=0
ro.hwui.max_gpu_font_atlas_bytes=1048576
ro.opengles.version=196610
ro.surface_flinger.discard_framebuffer_surface=true
ro.surface_flinger.protected_contents=true

# DRM
drm.service.enabled=true

# Media
media.aac_51_output_enabled=true
media.metrics.enabled=0
media.stagefright.enable-aac=true
media.stagefright.enable-http=true
media.stagefright.enable-player=true
media.stagefright.enable-qcp=true
media.stagefright.enable-scan=true

# Radio
ro.radio.noril=yes

# Wi-Fi
ro.wifi.channels=

# Wi-Fi Display
persist.debug.wfd.enable=1
persist.sys.wfd.virtual=0

# Miscellaneous
bt.max.hfpclient.connections=1
dalvik.vm.heapgrowthlimit=256m
dalvik.vm.heapmaxfree=8m
dalvik.vm.heapminfree=512k
dalvik.vm.heapsize=512m
dalvik.vm.heapstartsize=8m
dalvik.vm.heaptargetutilization=0.75
debug.gralloc.enable_fb_ubwc=1
debug.oculus.astcMura=0
debug.oculus.forceMura=3
debug.oculus.vrapilayers=GoCompatibility
mm.enable.qcom_parser=30408703
mm.enable.smoothstreaming=true
mmp.enable.3g2=true
net.bt.name=Android
ovr.panel.adjust_colorspace=1
ovr.panel.black_level=0.0001
ovr.panel.white_point.x=0.3127
ovr.panel.white_point.y=0.3290
persist.bt.a2dp.aac_disable=true
persist.hwc.enable_vds=1
persist.mm.enable.prefetch=true
persist.ovr.disable.sensorproxy=true
persist.ovr.global_cac=1
persist.ovr.nux_flow_version=1
persist.ovr.usb.xrsp_enabled=1
ro.af.client_heap_size_kbyte=7168
ro.boot.bootloader_ipd_offset=576
ro.carrier=unknown
ro.config.alarm_alert=Alarm_Classic.ogg
ro.config.event_filtering_enabled=true
ro.config.notification_sound=OnTheHunt.ogg
ro.config.telemetry_disk_size_limit_bytes=524288000
ro.config.upload_store_size_threshold=104857600
ro.control_privapp_permissions=enforce
ro.frp.pst=/dev/block/bootdevice/by-name/frp
ro.minui.default_rotation=ROTATION_DOWN
ro.oculus.sysimg.ver=1596585601
ro.ovr.displaydensity=16
ro.ovr.layoutscale=1.0
ro.ovr.os.api.version=129
ro.ovr.settings_uri=com.oculus.systemactivities/com.oculus.systemactivities.PlatformActivity
ro.recovery.ui.margin_height=480
ro.recovery.ui.margin_width=400
ro.sdm.alpha_filter_cfg=1
ro.sdm.detail_enhance=0
ro.sdm.direction_detection=0
ro.sdm.uv_filter_cfg=3
ro.sdm.y_rgb_filter_cfg=3
ro.sf.lcd_density_scale=0.42
vendor.debug.time_services.enable=false
vidc.enc.dcvs.extra-buff-count=2

